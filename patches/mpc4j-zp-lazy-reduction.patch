+                value = value.add(elementVector[i]);
+            }
+        }
+        return value.mod(prime);
+    }
+
+    /**
+     * Sums the elements at the positions and reduces once. Equal to the default, which reduces after every addition.
+     */
+    @Override
+    public BigInteger innerProduct(final BigInteger[] elementVector, final int[] positions) {
+        BigInteger value = BigInteger.ZERO;
+        for (int position : positions) {
+            assert validateElement(elementVector[position]);
+            value = value.add(elementVector[position]);
+        }
+        return value.mod(prime);
